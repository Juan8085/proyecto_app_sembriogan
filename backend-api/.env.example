# ==========================================
# SEMBRIOGAN - VARIABLES DE ENTORNO BACKEND
# ==========================================

# Puerto de ejecución del servidor (Render, Railway y Heroku asignan PORT automáticamente)
PORT=3000

# Conexión a la base de datos MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/sembriogan?retryWrites=true&w=majority

# Clave secreta para la firma de tokens JWT (Sesiones de 30 días para App Móvil y Web)
JWT_SECRET=FirmaSecretaSembriogan2026

# Autenticación con Google (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com

# Asistente Veterinario con Inteligencia Artificial (Google AI Studio Gemini)
GEMINI_API_KEY=tu-gemini-api-key

# Notificaciones Push Web (VAPID Keys)
VAPID_PUBLIC_KEY=tu-clave-publica-vapid
VAPID_PRIVATE_KEY=tu-clave-privada-vapid
VAPID_SUBJECT=mailto:contacto@sembriogan.com

# Pasarela de Pagos Wompi (Opcional si se configura desde el Panel Administrativo)
# WOMPI_PUBLIC_KEY=pub_prod_xxxxxx
# WOMPI_PRIVATE_KEY=prv_prod_xxxxxx
# WOMPI_INTEGRITY_KEY=prod_integrity_xxxxxx
