{
  "name": "proyecto_app_sembriogan",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para el proyecto Sembriogan",
  "workspaces": [
    "backend-api",
    "frontend-sembriogan",
    "app-veterinario"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "tunnel": "ngrok http 5173",
    "tunnel:api": "ngrok http 3000",
    "tunnel:all": "ngrok start --config ngrok.yml --all",
    "tunnel:lt": "npx localtunnel --port 5173",
    "tunnel:lt:api": "npx localtunnel --port 3000"
  },
  "devDependencies": {
    "prettier": "^3.0.3"
  }
}
